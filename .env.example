# -----------------------------------------------------------------------------
# Pune Book Festival — environment variables
# Copy to .env.local for development. Every value here is deployment-specific;
# nothing is hard-coded in the app.
# -----------------------------------------------------------------------------

# Supabase project URL (hosted: https://<ref>.supabase.co, local CLI: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable (anon) key. Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret (service role) key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used in QR codes and links (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC secret for signing pass QR tokens. At least 32 random characters.
#   openssl rand -base64 48
PASS_TOKEN_SECRET=

# HMAC secret for signing the venue self check-in QR. At least 32 random characters.
SELF_CHECKIN_SECRET=

# Email of the first admin, created by `pnpm seed:admin`.
ADMIN_BOOTSTRAP_EMAIL=
# Optional: password for the first admin (otherwise one is generated and printed once).
# ADMIN_BOOTSTRAP_PASSWORD=

# Optional: trust this header for the client IP used by rate limiting.
# Vercel sets x-forwarded-for; behind another proxy set the header it provides.
# CLIENT_IP_HEADER=x-forwarded-for

# Optional: multiply all per-IP rate limits (default 1). Raise for very busy shared networks.
# RATE_LIMIT_SCALE=1

# Optional: report Web Vitals to the server log (true/false).
# NEXT_PUBLIC_WEB_VITALS=false

# Optional: Sentry (or compatible) DSN for server-side error reporting.
# SENTRY_DSN=

# --- Later phase (not used yet) ---------------------------------------------
# EMAIL_PROVIDER_API_KEY=
# WHATSAPP_API_TOKEN=
