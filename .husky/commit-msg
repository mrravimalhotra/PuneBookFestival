# Conventional Commits: type(scope)!: subject
msg_file="$1"
first_line="$(head -n1 "$msg_file")"
if ! printf '%s' "$first_line" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,100}$|^Merge |^Revert '; then
  echo "✖ Commit message must follow Conventional Commits, e.g. 'feat(register): add consent checkbox'" >&2
  exit 1
fi
